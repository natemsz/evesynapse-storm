# EveSynapse swarm warmer — copy to .env and fill in. Never commit the filled file.
# The secret and contact are required; the node refuses to start without them.

# The swarm secret, shared with the main instance (>=32 random chars).
# Generate: openssl rand -hex 32
SHARED_CACHE_SECRET=

# Operator contact for CCP; travels in every ESI User-Agent.
ESI_CONTACT=you@example.com

# Seed worker URL for discovery heartbeats (empty = no heartbeat).
# Example: https://evesynapse-seed.<account>.workers.dev
SWARM_SEED_URL=

# Public https address of THIS node, as main instances dial it.
# Required when SWARM_SEED_URL is set.
# Example: https://warmer.example.com
PUBLIC_BASE_URL=

# Optional: loop tick, listen address, file paths.
POLL_INTERVAL=60s
BIND_ADDR=127.0.0.1:8079
DB_PATH=warmer.db
IDENTITY_PATH=warmer-identity.json
